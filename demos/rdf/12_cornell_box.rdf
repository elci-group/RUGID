@ontology cornell_box {
    @cell viewport {
        position: (0, 0, 0)
        extent: (800, 800, 0)
        fill: #000000
        projection: perspective
        camera_position: (250, 250, -500)
        camera_target: (250, 250, 250)
        camera_fov: 60
        
        // Back wall (white)
        @shape back_wall {
            type: rectangle
            position: (0, 0, 500)
            extent: (500, 500, 0)
            fill: #dddddd
            stroke: #000000
            stroke-width: 1
        }
        
        // Left wall (red)
        @shape left_wall {
            type: rectangle
            position: (0, 0, 0)
            extent: (500, 500, 0)
            fill: #aa3333
            rotation: (0, -90, 0)
            stroke: #000000
            stroke-width: 1
        }
        
        // Right wall (blue)
        @shape right_wall {
            type: rectangle
            position: (500, 0, 0)
            extent: (500, 500, 0)
            fill: #3333aa
            rotation: (0, 90, 0)
            stroke: #000000
            stroke-width: 1
        }
        
        // Floor (white)
        @shape floor {
            type: rectangle
            position: (0, 500, 0)
            extent: (500, 500, 0)
            fill: #dddddd
            rotation: (90, 0, 0)
            stroke: #000000
            stroke-width: 1
            
            @physics {
                static: true
                friction: 0.5
            }
        }
        
        // Ceiling (white)
        @shape ceiling {
            type: rectangle
            position: (0, 0, 0)
            extent: (500, 500, 0)
            fill: #dddddd
            rotation: (-90, 0, 0)
            stroke: #000000
            stroke-width: 1
        }
        
        // Tall box
        @shape tall_box {
            type: cube
            position: (150, 350, 200)
            extent: (100, 200, 100)
            fill: #ffffff
            stroke: #000000
            stroke-width: 1
            rotation: (0, 15, 0)
            
            @physics {
                velocity: (0, 0, 0)
                acceleration: (0, 400, 0)
                elasticity: 0.3
                friction: 0.6
                mass: 2.0
            }
            
            @collision {
                type: box
                response: bounce
                detect: [floor, short_box]
            }
        }
        
        // Short box
        @shape short_box {
            type: cube
            position: (350, 450, 300)
            extent: (100, 100, 100)
            fill: #ffffff
            stroke: #000000
            stroke-width: 1
            rotation: (0, -20, 0)
            
            @physics {
                static: true
                friction: 0.6
            }
        }
        
        // Light source
        @light point {
            position: (250, 100, 250)
            intensity: 1.2
            color: #ffffff
            radius: 400
            
            @animation flicker {
                property: intensity
                keyframes: [
                    { time: 0s, intensity: 1.2 },
                    { time: 0.1s, intensity: 1.15 },
                    { time: 0.2s, intensity: 1.2 }
                ]
                duration: 0.2s
                loop: infinite
            }
        }
    }
}
